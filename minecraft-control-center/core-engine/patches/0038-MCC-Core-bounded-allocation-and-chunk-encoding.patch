From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: MCC Core build <mcc-core-build@users.noreply.github.com>
Date: Sun, 11 Oct 2026 12:00:00 +0300
Subject: [PATCH] MCC Core bounded allocation and chunk encoding optimizations

Keep the standard Paper tick ownership, generation order, and game mechanics.
Pool bounded ore scratch with a nested-call fallback; iterate NBT entries
without a second hash lookup; encode contiguous long arrays in bulk with
scalar fallback; construct chunk snapshots without a stream/hash table;
remove redundant palette divider fields while preserving unsigned arithmetic.

Prior-art review: Leaf MC 0157/0174/0240/0316 and Gale CompoundTag iteration.
All new helper code is part of MCC Core, GPL-3.0-only. Upstream attribution
and license details are retained in THIRD-PARTY.md and licenses/.

diff --git a/net/minecraft/nbt/CompoundTag.java b/net/minecraft/nbt/CompoundTag.java
index b9f6aa7..c281adf 100644
--- a/net/minecraft/nbt/CompoundTag.java
+++ b/net/minecraft/nbt/CompoundTag.java
@@ -170,9 +170,18 @@ public final class CompoundTag implements Tag {
 
     @Override
     public void write(final DataOutput output) throws IOException {
-        for (String key : this.tags.keySet()) {
-            Tag tag = this.tags.get(key);
-            writeNamedTag(key, tag, output);
+        // MCC Core - avoid a second hash lookup and per-entry allocation for
+        // Paper's usual fastutil map, without changing its iteration order.
+        if (this.tags instanceof it.unimi.dsi.fastutil.objects.Object2ObjectMap<String, Tag> fastMap) {
+            final var entries = it.unimi.dsi.fastutil.objects.Object2ObjectMaps.fastIterator(fastMap);
+            while (entries.hasNext()) {
+                final var entry = entries.next();
+                writeNamedTag(entry.getKey(), entry.getValue(), output);
+            }
+        } else {
+            for (Entry<String, Tag> entry : this.tags.entrySet()) {
+                writeNamedTag(entry.getKey(), entry.getValue(), output);
+            }
         }
 
         output.writeByte(0);
diff --git a/net/minecraft/network/FriendlyByteBuf.java b/net/minecraft/network/FriendlyByteBuf.java
index b63d246..ffb0ea2 100644
--- a/net/minecraft/network/FriendlyByteBuf.java
+++ b/net/minecraft/network/FriendlyByteBuf.java
@@ -267,9 +267,7 @@ public class FriendlyByteBuf extends ByteBuf {
     }
 
     public static void writeFixedSizeLongArray(final ByteBuf output, final long[] longs) {
-        for (long l : longs) {
-            output.writeLong(l);
-        }
+        dev.mcc.core.engine.LongArrayWriter.writeFixed(output, longs); // MCC Core - bounded contiguous bulk encoding
     }
 
     public long[] readLongArray() {
diff --git a/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java b/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java
